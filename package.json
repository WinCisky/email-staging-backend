{
	"name": "email-staging-backend",
	"private": true,
	"description": "Mock SMTP server and HTTP API to catch and inspect the emails sent by staging environments",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start:smtp": "node smtp-mock-server.js",
		"start:api": "node api.js",
		"dev": "concurrently --names smtp,api \"SMTP_SECURE=false node --watch smtp-mock-server.js\" \"node --watch api.js\"",
		"send-test-email": "node client.js",
		"test": "node --test \"test/**/*.test.js\""
	},
	"dependencies": {
		"@fastify/cors": "^11.3.1",
		"@fastify/rate-limit": "^11.2.1",
		"fastify": "^5.12.7",
		"smtp-server": "^3.20.2"
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"nodemailer": "^10.1.7"
	}
}
