# Copy to .env (next to this file) and uncomment what you need: every value below is the default.
# Read by both processes at startup (restart them to apply changes). Variables already set in the
# environment (shell, pm2 "env") take precedence over this file.

# --- Storage -----------------------------------------------------------------
# SQLite database, shared by both processes (relative to the project directory)
# DB_PATH=emails.sql
# Emails older than this are deleted every hour (0 = keep forever)
# RETENTION_DAYS=30
# New messages are refused with "452 try again later" above this size (0 = unlimited)
# MAX_STORAGE_MB=2048

# --- SMTP server -----------------------------------------------------------------
# Listen address (empty = all interfaces)
# SMTP_HOST=
# SMTP_PORT=2525
# Implicit TLS (like port 465). false = plain text: local development only!
# SMTP_SECURE=true
# Must be readable by the user running the process (see README, "TLS certificates")
# SMTP_TLS_KEY=/etc/letsencrypt/live/test.opentrust.it/privkey.pem
# SMTP_TLS_CERT=/etc/letsencrypt/live/test.opentrust.it/fullchain.pem
# SMTP_MAX_MESSAGE_MB=10
# SMTP_MAX_CLIENTS=20
# SMTP_MAX_RECIPIENTS=50
# Messages per minute per client IP (0 = unlimited)
# SMTP_RATE_LIMIT=120

# --- HTTP API --------------------------------------------------------------------
# Keep it on localhost and publish it through the reverse proxy (nginx)
# API_HOST=localhost
# API_PORT=3628
# Allowed browser origins, comma separated, e.g. https://wincisky.github.io
# CORS_ORIGIN=*
# Proxies allowed to set X-Forwarded-For: IPs/CIDRs or loopback, linklocal, uniquelocal (false = none)
# TRUST_PROXY=loopback
# Requests per minute per client IP (0 = unlimited)
# API_RATE_LIMIT=300

# --- Logging ---------------------------------------------------------------------
# debug | info | warn | error | silent
# LOG_LEVEL=info
